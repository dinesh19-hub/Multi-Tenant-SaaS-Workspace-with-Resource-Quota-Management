# ==============================================================================
# Git Ignore Configuration - Multi-Tenant SaaS Workspace
# ==============================================================================

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# AWS credentials & local SAM artifacts
.aws-sam/
samconfig.toml
aws-credentials*

# Archives and build bundles
*.zip
*.tar.gz
*.tgz

# Dependency directories
node_modules/
jspm_packages/

# Production build outputs
dist/
build/
out/
.next/
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit test coverage
coverage/
*.lcov

# Editor and IDE directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/
scratch/
