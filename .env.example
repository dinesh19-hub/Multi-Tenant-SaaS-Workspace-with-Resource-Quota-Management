# ==============================================================================
# Multi-Tenant SaaS Workspace — Environment Configuration Template
# ==============================================================================
# This template documents all environment variables used across the frontend
# and backend services.
#
# SECURITY NOTICE:
# - All "VITE_*" variables are embedded into the client-side JavaScript bundle.
#   NEVER place AWS secret keys, access tokens, or private credentials here.
# - In production, server-side variables are automatically provisioned and
#   injected by AWS SAM / CloudFormation into the Lambda execution environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CLIENT CONFIGURATION (Public SPA / Vite)
# Target file: frontend/.env (local) or AWS Amplify Hosting Environment Variables
# ------------------------------------------------------------------------------

# [REQUIRED] AWS Region where Cognito and API Gateway are deployed.
# Example: ap-southeast-2
VITE_AWS_REGION=ap-southeast-2

# [REQUIRED] Amazon Cognito User Pool ID.
# Format: <region>_<identifier>
# Example: ap-southeast-2_EFWnRtGuA
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx

# [REQUIRED] Amazon Cognito App Client ID (Public Web Client without client secret).
# Format: 26-character alphanumeric string
# Example: 4b7blb7ojmv1drb91715i2676
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# [REQUIRED] Amazon API Gateway HTTP API base URL with version prefix (/api/v1).
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/api/v1
# Example: https://sdu2useqyb.execute-api.ap-southeast-2.amazonaws.com/api/v1
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com/api/v1

# [OPTIONAL] Mock Mode Toggle for local offline UI development.
# Values: false (default, connects to live AWS) | true (uses mock in-memory state)
VITE_USE_MOCK_AUTH=false

# ------------------------------------------------------------------------------
# 2. BACKEND RUNTIME CONFIGURATION (Server-Side / AWS Lambda / SAM)
# In production, these are automatically configured via template.yaml parameters.
# For local backend testing against live AWS DynamoDB, configure backend/.env:
# ------------------------------------------------------------------------------

# [SERVER-SIDE] DynamoDB single-table name.
# Injected automatically by SAM template in production.
# Example: saas-workspace-stack-table
TABLE_NAME=saas-workspace-stack-table

# [SERVER-SIDE] Allowed CORS Origin for HTTP API responses.
# Injected automatically by SAM template in production.
# Example: https://main.d2h2pxsqugbcgb.amplifyapp.com
ALLOWED_ORIGIN=https://main.d2h2pxsqugbcgb.amplifyapp.com

# [SERVER-SIDE] Local backend test flag: set to 'true' to connect to real DynamoDB.
# Defaults to in-memory mock repository if unset.
# USE_REAL_DYNAMODB=false
